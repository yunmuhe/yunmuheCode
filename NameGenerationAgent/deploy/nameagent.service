[Unit]
Description=Name Generation Agent API Service
Documentation=https://github.com/yunmuhe/yunmuheCode
# 默认按 monorepo 布局编写：仓库根目录 /opt/yunmuheCode，后端位于 NameGenerationAgent/。
# deploy_to_server.sh 会用实际的 APP_DIR 替换 /opt/yunmuheCode；手工部署到其他目录时请同步修改。
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/yunmuheCode/NameGenerationAgent
Environment="PATH=/opt/yunmuheCode/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# 启动命令
ExecStart=/opt/yunmuheCode/.venv/bin/python /opt/yunmuheCode/NameGenerationAgent/main.py

# 启动前检查（可选）
# ExecStartPre=/bin/sleep 2

# 优雅停止
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30

# 自动重启策略
Restart=always
RestartSec=10
StartLimitInterval=400
StartLimitBurst=3

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nameagent

# 资源限制（可选）
# LimitNOFILE=65536
# LimitNPROC=4096

# 安全加固（可选）
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/opt/yunmuheCode/NameGenerationAgent/data /opt/yunmuheCode/NameGenerationAgent/logs

[Install]
WantedBy=multi-user.target
